<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nativeRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#090D16">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
        <ImageView android:layout_width="36dp" android:layout_height="40dp" android:src="@drawable/app_icon" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_brand" android:textColor="#EDD6A4" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/>
            <TextView android:id="@+id/nativeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/private_access" android:textColor="#B9C1D0" android:textSize="12sp" android:layout_marginTop="3dp"/>
        </LinearLayout>
        <ImageButton android:id="@+id/refreshPanel" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_refresh" android:contentDescription="@string/refresh" android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/homeScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingTop="24dp" android:paddingBottom="28dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/eyebrow" android:textColor="#D8C08E" android:textSize="12sp" android:letterSpacing="0.12"/>
                <TextView android:id="@+id/homeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_title" android:textColor="#F5F4F0" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="0dp" android:layout_marginTop="10dp" android:accessibilityHeading="true"/>
                <TextView style="@style/MobileBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_description" android:layout_marginTop="12dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_hero" android:padding="22dp" android:layout_marginTop="26dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_camera" android:tint="#EDD6A4" android:importantForAccessibility="no"/>
                    <TextView style="@style/MobileTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/live_title" android:layout_marginTop="18dp"/>
                    <TextView style="@style/MobileBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/live_description" android:layout_marginTop="8dp"/>
                    <Button android:id="@+id/openLive" style="@style/MobilePrimaryButton" android:text="@string/open_live" android:layout_marginTop="20dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/protected_label" android:textColor="#D0D6DF" android:textSize="12sp" android:layout_marginTop="14dp" android:gravity="center"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                    <LinearLayout android:id="@+id/openRecordings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/card_surface" android:padding="18dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/recordings" android:minHeight="136dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_recordings" android:importantForAccessibility="no"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recordings" android:textColor="#F5F4F0" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="14dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recordings_description" android:textColor="#C4CAD5" android:textSize="12sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <Space android:layout_width="12dp" android:layout_height="1dp"/>
                    <LinearLayout android:id="@+id/openSettings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/card_surface" android:padding="18dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/settings" android:minHeight="136dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_settings" android:importantForAccessibility="no"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings" android:textColor="#F5F4F0" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="14dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_description" android:textColor="#C4CAD5" android:textSize="12sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="26dp" android:gravity="top">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_computer" android:tint="#D8C08E" android:importantForAccessibility="no"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/how_it_works" android:textColor="#E1E5ED" android:textSize="15sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/how_it_works_description" android:textColor="#B9C1D0" android:textSize="13sp" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preview_note" android:textColor="#B9C1D0" android:textSize="12sp" android:layout_marginTop="24dp"/>
            </LinearLayout>
        </ScrollView>
        <WebView android:id="@+id/ownerWeb" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
        <ProgressBar android:id="@+id/panelLoading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:visibility="gone" android:contentDescription="@string/loading"/>
        <ScrollView android:id="@+id/errorScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true" android:background="#090D16">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:gravity="center_vertical">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_refresh" android:tint="#EDD6A4" android:importantForAccessibility="no"/>
                <TextView android:id="@+id/errorTitle" style="@style/MobileTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_error_title" android:layout_marginTop="24dp"/>
                <TextView android:id="@+id/errorDescription" style="@style/MobileBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_error_description" android:layout_marginTop="16dp"/>
                <Button android:id="@+id/retryPanel" style="@style/MobilePrimaryButton" android:text="@string/retry" android:layout_marginTop="28dp"/>
                <Button android:id="@+id/errorGoHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/go_home" android:textAllCaps="false" android:textColor="#F5F4F0" android:backgroundTint="#242B3A" android:layout_marginTop="12dp"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <LinearLayout android:id="@+id/nativeBottomNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="#101622" android:paddingHorizontal="12dp" android:paddingVertical="8dp">
        <TextView android:id="@+id/navHome" style="@style/MobileNav" android:drawableTop="@drawable/ic_home" android:text="@string/nav_home"/>
        <TextView android:id="@+id/navLive" style="@style/MobileNav" android:drawableTop="@drawable/ic_camera" android:text="@string/nav_live"/>
        <TextView android:id="@+id/navRecordings" style="@style/MobileNav" android:drawableTop="@drawable/ic_recordings" android:text="@string/recordings"/>
        <TextView android:id="@+id/navAccount" style="@style/MobileNav" android:drawableTop="@drawable/ic_settings" android:text="@string/nav_account"/>
    </LinearLayout>
</LinearLayout>
