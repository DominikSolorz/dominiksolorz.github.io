<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HomeSecurityDesktop</AssemblyName>
    <RootNamespace>HomeSecurityDesktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.7</Version>
    <AssemblyVersion>1.4.7.0</AssemblyVersion>
    <FileVersion>1.4.7.0</FileVersion>
    <ApplicationIcon>installer/brand/home-security.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../kamera/**/*" Exclude="../kamera/downloads/**/*;../kamera/updates/**/*;../kamera/**/*.gs;../kamera/**/*.bat;../kamera/**/*.vbs;../kamera/desktop-update.json">
      <Link>Panel/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="installer/brand/home-security.ico" Link="home-security.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AgentTestAssets/index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AgentTestAssets/untrusted.html" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../agent-client/HomeSecurity.Agent.Client.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" />
  </ItemGroup>
</Project>
