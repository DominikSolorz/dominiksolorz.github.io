// Separate Apps Script project: HOME SECURITY Contact. No Drive or inbox access.
// CONTACT_RELAY_SECRET is configured in Script Properties, never in source.
function doGet() { return contactJson({service:'home-security-contact',version:5,ready:!!PropertiesService.getScriptProperties().getProperty('CONTACT_RELAY_SECRET'),serverTime:Date.now()}); }
function doPost(e) {
  var lock=LockService.getScriptLock();
  try {
    var raw=e && e.postData && e.postData.contents;
    if(!raw || raw.length>16000)return contactJson({ok:false,error:'invalid_request'});
    var envelope=JSON.parse(raw),ticket=envelope.ticket;
    var props=PropertiesService.getScriptProperties(),secret=props.getProperty('CONTACT_RELAY_SECRET');
    if(!secret || !ticket || !Number.isSafeInteger(envelope.issuedAt) || Math.abs(Date.now()-envelope.issuedAt)>300000)return contactJson({ok:false,error:'unauthorized',reason:!secret?'not_configured':!ticket?'missing_ticket':!Number.isSafeInteger(envelope.issuedAt)?'invalid_time':'expired'});
    var canonical=JSON.stringify([ticket.requestId,ticket.name,ticket.surname,ticket.email,ticket.topic,ticket.message,ticket.consent]);
    var expected=Utilities.computeHmacSha256Signature(canonical+'\n'+envelope.issuedAt,secret,Utilities.Charset.UTF_8).map(function(b){return ((b+256)%256).toString(16).padStart(2,'0');}).join('');
    if(typeof envelope.signature!=='string'||envelope.signature.length!==expected.length)return contactJson({ok:false,error:'unauthorized',reason:'invalid_signature_format'});
    var diff=0;for(var i=0;i<expected.length;i++)diff|=expected.charCodeAt(i)^envelope.signature.charCodeAt(i);
    if(diff)return contactJson({ok:false,error:'unauthorized',reason:'signature_mismatch'});
    if(!/^[a-f0-9-]{36}$/.test(ticket.requestId)||ticket.consent!==true||typeof ticket.name!=='string'||typeof ticket.surname!=='string'||typeof ticket.email!=='string'||typeof ticket.topic!=='string'||typeof ticket.message!=='string')return contactJson({ok:false,error:'invalid_request'});
    if(ticket.name.length>80||ticket.surname.length>80||ticket.email.length>254||ticket.topic.length>100||ticket.message.length<10||ticket.message.length>4000||!ticket.name.trim()||!ticket.surname.trim()||/[\r\n]/.test(ticket.email+ticket.name+ticket.surname+ticket.topic)||!/^[^\s@,;<>]+@[^\s@,;<>]+\.[^\s@,;<>]+$/.test(ticket.email))return contactJson({ok:false,error:'invalid_request'});
    var digest=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,canonical,Utilities.Charset.UTF_8).map(function(b){return ((b+256)%256).toString(16).padStart(2,'0');}).join('');
    lock.waitLock(5000);
    var now=Date.now(),all=props.getProperties();
    Object.keys(all).forEach(function(k){if(k.indexOf('ticket:')===0){try{if(JSON.parse(all[k]).expires<now)props.deleteProperty(k);}catch(_){}}});
    var id='ticket:'+ticket.requestId,previous=props.getProperty(id);
    if(previous){var state=JSON.parse(previous);if(state.digest!==digest)return contactJson({ok:false,error:'conflict'});return contactJson(state.status==='sent'?contactReceipt(ticket,state):{ok:false,error:'delivery_unknown',requestId:ticket.requestId});}
    var day=new Date().toISOString().slice(0,10),daily=JSON.parse(props.getProperty('daily')||'{}');
    if(daily.day!==day)daily={day:day,used:0};
    if(daily.used>=50||MailApp.getRemainingDailyQuota()<2)return contactJson({ok:false,error:'rate_limited'});
    var senderHash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,ticket.email.toLowerCase()).map(function(b){return ((b+256)%256).toString(16).padStart(2,'0');}).join('');
    var senderKey='sender:'+senderHash,last=Number(props.getProperty(senderKey)||0);
    if(now-last<60000)return contactJson({ok:false,error:'rate_limited'});
    Object.keys(all).forEach(function(k){if(k.indexOf('sender:')===0&&Number(all[k])<now-86400000)props.deleteProperty(k);});
    props.setProperty(senderKey,String(now));daily.used++;props.setProperty('daily',JSON.stringify(daily));
    var entry={digest:digest,status:'sending',copyStatus:'not_sent',created:now,expires:now+172800000};props.setProperty(id,JSON.stringify(entry));
    try {
      MailApp.sendEmail(contactMail(ticket,'owner',now));
      entry.status='sent';props.setProperty(id,JSON.stringify(entry));
    }catch(_){entry.status='unknown';props.setProperty(id,JSON.stringify(entry));return contactJson({ok:false,error:'delivery_unknown',requestId:ticket.requestId});}
    entry.copyStatus='sending';props.setProperty(id,JSON.stringify(entry));
    try{MailApp.sendEmail(contactMail(ticket,'copy',now));entry.copyStatus='sent';}
    catch(_){entry.copyStatus='unknown';}
    props.setProperty(id,JSON.stringify(entry));
    return contactJson(contactReceipt(ticket,entry));
  }catch(_){return contactJson({ok:false,error:'service_unavailable'});}
  finally{if(lock.hasLock())lock.releaseLock();}
}
function contactJson(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}
function contactReceipt(ticket,state){return {ok:true,status:'sent',requestId:ticket.requestId,ticketNumber:contactNumber(ticket),copyStatus:state.copyStatus==='sent'?'sent':state.copyStatus==='unknown'||state.copyStatus==='sending'?'unknown':'not_sent'};}
function contactNumber(ticket){return 'HS-'+ticket.requestId.slice(0,8).toUpperCase();}
function contactEscape(value){return String(value).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function contactMail(ticket,kind,now){
  var owner='goldservicepoland@gmail.com',copy=kind==='copy',number=contactNumber(ticket),name=ticket.name+' '+ticket.surname;
  var date=new Date(now).toLocaleString('pl-PL',{timeZone:'Europe/Warsaw'}),e=contactEscape;
  var title=copy?'Potwierdzenie otrzymania wiadomości':'Zgłoszenie do obsługi';
  var intro=copy?'Szanowni Państwo,<br><br>potwierdzamy otrzymanie wiadomości przesłanej za pośrednictwem formularza HOME SECURITY. Zgłoszeniu nadano wskazany poniżej numer sprawy. Kopia przesłanej treści stanowi dalszą część niniejszego potwierdzenia.':'Szanowni Państwo,<br><br>za pośrednictwem formularza kontaktowego HOME SECURITY wpłynęło zgłoszenie wymagające zapoznania się z treścią i udzielenia odpowiedzi. Poniżej przedstawiamy dane zgłaszającego oraz pełną treść wiadomości.';
  var replyTo=copy?owner:ticket.email,subject='['+number+'] '+(copy?'Potwierdzenie zgłoszenia':ticket.topic+' — nowe zgłoszenie');
  var sender=name,senderMail=ticket.email,recipient='DS Home Security',recipientMail=owner;
  var initials=(Array.from(ticket.name.trim())[0]||'')+(Array.from(ticket.surname.trim())[0]||'');
  var next=copy?'Potwierdzenie dotyczy przyjęcia wiadomości, nie rozstrzygnięcia sprawy. Odpowiedź zostanie skierowana na podany adres e-mail. W dalszej korespondencji prosimy zachować numer sprawy w temacie.':'Prosimy o zapoznanie się z treścią zgłoszenia. Odpowiedź należy skierować na adres zgłaszającego, zachowując numer sprawy w temacie. Przycisk „Odpowiedz” w programie pocztowym jest ustawiony na właściwego adresata.';
  var action='mailto:'+encodeURIComponent(replyTo)+'?subject='+encodeURIComponent('Re: ['+number+'] '+ticket.topic);
  var html=`<!doctype html><html lang="pl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>@media(max-width:520px){.letterPad{padding:22px 18px!important}.party{display:block!important;width:auto!important}.partySpace{display:none!important}.letterTitle{font-size:25px!important}}</style></head>
<body style="margin:0;padding:0;background:#061522;font-family:Arial,Helvetica,sans-serif;color:#17202a"><div style="display:none;max-height:0;overflow:hidden">${e(number+' · '+title+' · '+ticket.topic)}</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#061522"><tr><td align="center" style="padding:24px 8px">
<table role="presentation" width="720" cellspacing="0" cellpadding="0" style="width:100%;max-width:720px;border:2px solid #c8a05a;border-collapse:collapse;background:#13263a">
<tr><td class="letterPad" style="padding:26px 30px;background:#0b1d2e;border-bottom:3px solid #c8a05a"><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td width="86" style="vertical-align:middle;padding-right:18px"><img src="cid:hslogo" width="76" height="76" alt="Herb DS" style="display:block;border:0;max-width:100%;height:auto"></td><td style="vertical-align:middle;color:#f5ead2"><div style="font-family:Georgia,serif;font-size:28px;line-height:1.2;letter-spacing:1px">HOME SECURITY</div><div style="margin-top:8px;color:#d9bd82;font-size:10px;line-height:1.6;letter-spacing:2px">KORESPONDENCJA · KONTAKT · POMOC</div></td></tr></table></td></tr>
<tr><td class="letterPad" style="padding:24px 28px 16px;background:#13263a"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="table-layout:fixed;border-collapse:collapse"><tr>
<td class="party" width="48%" style="vertical-align:top;padding:18px;background:#eee5d5;border:1px solid #c8a05a;overflow-wrap:anywhere"><div style="font-size:10px;letter-spacing:1.3px;color:#81663a;font-weight:bold">ZGŁASZAJĄCY / TWOJE DANE</div><div aria-label="Inicjały zgłaszającego" style="margin-top:14px;width:64px;height:64px;line-height:64px;text-align:center;background:#0b1d2e;border:1px solid #c8a05a;color:#f2d28d;font-family:Georgia,serif;font-size:25px">${e(initials.toUpperCase())}</div><div style="margin-top:10px;font-family:Georgia,serif;font-size:20px;color:#0b1d2e">${e(sender)}</div><div style="margin-top:9px;font-size:12px;line-height:1.6;color:#34404a;word-break:break-all">${e(senderMail)}</div><div style="margin-top:7px;font-size:11px;color:#655b4c">Dane podane w formularzu zgłoszenia</div></td>
<td class="partySpace" width="4%"></td>
<td class="party" width="48%" style="vertical-align:top;padding:18px;background:#eee5d5;border:1px solid #c8a05a;overflow-wrap:anywhere"><div style="font-size:10px;letter-spacing:1.3px;color:#81663a;font-weight:bold">ADRESAT / DS HOME SECURITY</div><img src="cid:hslogo" width="64" height="64" alt="Herb DS Home Security" style="display:block;margin-top:14px;border:0"><div style="margin-top:10px;font-family:Georgia,serif;font-size:20px;color:#0b1d2e">${e(recipient)}</div><div style="margin-top:8px;font-size:12px;line-height:1.7;color:#34404a">Systemy monitoringu i bezpieczeństwa<br><strong>Dominik Solorz — twórca projektu</strong></div><div style="margin-top:9px;font-size:12px;line-height:1.6;color:#34404a;word-break:break-all">${e(recipientMail)}</div><div style="margin-top:7px;font-size:11px;color:#655b4c">Marka projektu · Kontakt i pomoc</div></td></tr></table></td></tr>
<tr><td class="letterPad" style="padding:0 28px 22px;background:#13263a"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border:1px solid #4e6072;background:#0b1d2e"><tr><td style="padding:14px;color:#b7c1ca;font-size:11px;line-height:1.8">NUMER SPRAWY: <strong style="color:#f2d28d;font-size:15px">${e(number)}</strong><br>DATA PRZYJĘCIA: ${e(date)} · Europe/Warsaw</td></tr></table></td></tr>
<tr><td class="letterPad" style="padding:28px 30px;background:#fcfbf8"><div style="font-size:10px;letter-spacing:1.7px;color:#8a6b36;font-weight:bold">${copy?'POTWIERDZENIE PRZYJĘCIA ZGŁOSZENIA':'KORESPONDENCJA Z FORMULARZA KONTAKTOWEGO'}</div><h1 class="letterTitle" style="margin:10px 0 18px;font-family:Georgia,serif;font-size:28px;font-weight:normal;line-height:1.3;color:#0b1d2e">${title}</h1>
<div style="padding:12px 14px;border-left:4px solid #c8a05a;background:#eee5d5;font-size:14px;color:#34404a"><strong>Dotyczy:</strong> ${e(ticket.topic)}</div><p style="margin:24px 0;font-size:14px;line-height:1.9;color:#2e3942">${intro}</p>
<h2 style="margin:24px 0 12px;padding-bottom:9px;border-bottom:1px solid #d0ba8a;font-family:Georgia,serif;font-size:20px;font-weight:normal;color:#0b1d2e">${copy?'Kopia Twojej wiadomości':'Treść przekazanego zgłoszenia'}</h2>
<div style="padding:18px;background:#f4ecde;border:1px solid #d0ba8a;font-size:14px;line-height:1.9;color:#2e3942;overflow-wrap:anywhere;word-break:break-word">${e(ticket.message).replace(/\r?\n/g,'<br>')}</div>
<h2 style="margin:26px 0 10px;font-family:Georgia,serif;font-size:20px;font-weight:normal;color:#0b1d2e">Dalsza korespondencja</h2><p style="font-size:14px;line-height:1.9;color:#2e3942">${next}</p>
<table role="presentation" cellspacing="0" cellpadding="0" style="margin:20px 0 28px"><tr><td style="border:1px solid #c8a05a;background:#0b1d2e"><a href="${e(action)}" style="display:inline-block;padding:14px 18px;color:#f2d28d;text-decoration:none;font-size:12px;font-weight:bold;letter-spacing:.5px">${copy?'ODPOWIEDZ W SPRAWIE ZGŁOSZENIA':'ODPOWIEDZ ZGŁASZAJĄCEMU'}</a></td></tr></table>
<p style="font-size:14px;line-height:1.8;color:#2e3942;margin:0">Z poważaniem,<br><strong style="font-family:Georgia,serif;font-size:18px;color:#0b1d2e">HOME SECURITY</strong><br><span style="font-size:12px;color:#65717a">Kontakt i pomoc techniczna</span></p></td></tr>
<tr><td class="letterPad" style="padding:20px 28px;background:#0b1d2e;border-top:2px solid #c8a05a;color:#b7c1ca;font-size:11px;line-height:1.8">Wiadomość wygenerowana automatycznie w związku ze zgłoszeniem z formularza. Możesz na nią odpowiedzieć.<br>Nie przesyłaj haseł, PIN-ów, kodów weryfikacyjnych ani tokenów.<br>${copy?'Jeżeli to nie Ty wysłałeś formularz, zignoruj tę wiadomość.<br>':''}<a href="https://dominiksolorz.github.io/kamera/pomoc.html" style="color:#f2d28d">Kontakt</a> · <a href="https://dominiksolorz.github.io/kamera/polityka-prywatnosci.html" style="color:#f2d28d">Polityka prywatności</a><br><span style="font-size:9px">Identyfikator techniczny: ${e(ticket.requestId)}</span></td></tr>
</table></td></tr></table></body></html>`;
  return {to:copy?ticket.email:owner,replyTo:replyTo,name:'HOME SECURITY — kontakt',subject:subject,body:[title,'Numer sprawy: '+number,'Data przyjęcia: '+date+' · Europe/Warsaw','NADAWCA: '+sender+' <'+senderMail+'>','ADRESAT: '+recipient+' <'+recipientMail+'>','Dotyczy: '+ticket.topic,'',copy?'Kopia Twojej wiadomości:':'Treść zgłoszenia:',ticket.message,'','Dalsza korespondencja',next,'','Z poważaniem,','HOME SECURITY · Kontakt i pomoc techniczna','Nie wysyłaj haseł ani PIN-ów.','Identyfikator techniczny: '+ticket.requestId].join('\n'),htmlBody:html,inlineImages:{hslogo:contactLogo()}};
}

function contactLogo(){return Utilities.newBlob(Utilities.base64Decode(''),'image/jpeg','home-security-logo.jpg');}
